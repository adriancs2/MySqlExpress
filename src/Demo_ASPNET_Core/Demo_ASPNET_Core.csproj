<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Demo_ASPNET_Core</RootNamespace>
    <AssemblyName>Demo_ASPNET_Core</AssemblyName>
    <!--
      LangVersion 7.3 keeps the demo's source language compatible with the
      Web Forms sibling project. The Pageless philosophy values *no surprise*
      between the two editions; raising the language version is unnecessary.
    -->
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
  </ItemGroup>

</Project>
